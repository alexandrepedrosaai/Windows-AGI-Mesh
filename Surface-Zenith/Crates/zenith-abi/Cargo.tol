[package]
name        = "zenith-abi" 
version     = "0.1.0"
edition     = "2021"
description = "Surface Zenith Universal ABI - Domain types, object model, capability tokens"
authors     = ["Surface Zenith Team"]
license     = "MIT"

[dependencies]
serde       = { workspace = true }
serde_json  = { workspace = true }
uuid        = { workspace = true }
thiserror   = { workspace = true }
bincode     = { workspace = true }
chrono      = { workspace = true }
sha2        = { workspace = true }
bytes       = { workspace = true }

[dev-dependencies]
criterion   = { workspace = true }
