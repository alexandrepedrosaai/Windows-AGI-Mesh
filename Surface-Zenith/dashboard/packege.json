    "@types/uuid":              "^9.0.7",
    "@types/node":              "^20.10.4",
    "typescript":               "^5.3.3",
    "react-scripts":            "5.0.1",
    "eslint":                   "^8.55.0",
    "prettier":                 "^3.1.1",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser":        "^6.14.0"
