circuit AGIMeshWeb {
  version = "0.1"
  kind = benchmark

  scope {
    purpose = "Evaluate general-intelligence-relevant behavior across reasoning, adaptation, knowledge use, and tool interaction."
    inputs = ["versioned benchmark tasks", "model or agent endpoint", "declared runtime configuration"]
    outputs = ["task-level scores", "confidence and failure summaries", "reproducibility manifest"]
    boundaries = ["Scores are task- and version-specific and are not proof of general intelligence.", "Web access is disabled unless a test explicitly requires it."]
  }

  metrics {
    task_accuracy = { unit: "percent", target: "Report per task family and aggregate with confidence intervals." }
    transfer_retention = { unit: "percent", target: "Measure held-out task performance after adaptation." }
    tool_safety = { unit: "percent", target: "Report policy-compliant tool calls and unsafe-action rate separately." }
    run_reproducibility = { unit: "percent", target: "100% of runs record task, model, prompt, and environment versions." }
  }

  integration_pipeline {
    stage select { action = "Resolve a signed benchmark version and an access-controlled evaluation split." }
    stage isolate { action = "Run the candidate in a sandbox with scoped credentials, resource limits, and network policy." }
    stage execute { action = "Apply fixed task protocols and preserve raw responses with privacy controls." }
    stage score { action = "Use versioned scoring rules; separate automated scoring from human review." }
    stage report { action = "Publish aggregate results, confidence intervals, limitations, and reproducibility metadata." }
  }

  security {
    rules = [
      "Do not expose held-out answers or evaluator secrets to candidate systems.",
      "Use least-privilege, short-lived credentials for any explicitly enabled web or tool access.",
      "Block arbitrary network and filesystem access by default.",
      "Redact personal data from submitted responses and reports.",
      "Retain evaluation traces only under the documented retention policy."
    ]
  }
}
