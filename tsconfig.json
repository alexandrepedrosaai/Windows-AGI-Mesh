{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "strict": true,

    "baseUrl": ".",

    "paths": {
      "@/*": [
        "src/*"
      ]
    },

    "types": [
      "node",
      "vitest/globals"
    ],

    "outDir": "dist",

    "sourceMap": true
  },

  "include": [
    "src/**/*.ts",
    "tests/**/*.ts",
    "vitest.config.ts"
  ]
}
