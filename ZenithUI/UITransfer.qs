zcorr:
  %zidx = and i64 %zv, 7
  %zcp = call i8* @__quantum__rt__array_get_element_ptr_1d(%Array* %qubits, i64 %zidx)
  %zcq = load %Qubit*, %Qubit** (bitcast i8* %zcp to %Qubit**)
  call void @__quantum__qis__x__body(%Qubit* %zcq)
  br label %done
done:
  ret void
}

