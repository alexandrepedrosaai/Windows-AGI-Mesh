  call void @__quantum__qis__cx__body(%Qubit* %zq2, %Qubit* %az2)
  %rz2 = call %Result* @__quantum__qis__mresetz__body(%Qubit* %az2)
  %oz2 = call %Result* @__quantum__rt__result_get_one()
