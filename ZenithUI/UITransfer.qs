xcorr:
  %xidx = and i64 %xv, 7
  %xcp = call i8* @__quantum__rt__array_get_element_ptr_1d(%Array* %qubits, i64 %xidx)
  %xcq = load %Qubit*, %Qubit** (bitcast i8* %xcp to %Qubit**)
