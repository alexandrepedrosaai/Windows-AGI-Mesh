  %vp0_2 = getelementptr double, double* %params, i32 2
  %vv0_2 = load double, double* %vp0_2
  %vqp0_2 = call i8* @__quantum__rt__array_get_element_ptr_1d(%Array* %qubits, i64 2)
  %vq0_2 = load %Qubit*, %Qubit** (bitcast i8* %vqp0_2 to %Qubit**)
