define void @SurfaceCode.correct(%Array* %qubits, %ErrorSyndrome* %syn) {
entry:
  %xf2 = getelementptr %ErrorSyndrome, %ErrorSyndrome* %syn, i32 0, i32 0
  %zf2 = getelementptr %ErrorSyndrome, %ErrorSyndrome* %syn, i32 0, i32 1
