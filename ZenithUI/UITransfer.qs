define void @graph_sync.circuit_11(%Array* %qubits, double %theta, double %phi) {
entry:
  %p11_0 = call i8* @__quantum__rt__array_get_element_ptr_1d(%Array* %qubits, i64 0)
  %q11_0 = load %Qubit*, %Qubit** (bitcast i8* %p11_0 to %Qubit**)
