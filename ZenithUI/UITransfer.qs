  %rx2 = call %Result* @__quantum__qis__mresetz__body(%Qubit* %ax2)
  %ox2 = call %Result* @__quantum__rt__result_get_one()
  %ix2 = call i1 @__quantum__rt__result_equal(%Result* %rx2, %Result* %ox2)
  %bx2 = zext i1 %ix2 to i64
  %sx2 = shl i64 %bx2, 2
