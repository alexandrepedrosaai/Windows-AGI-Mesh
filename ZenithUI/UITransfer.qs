  %eq11_1p = call i8* @__quantum__rt__array_get_element_ptr_1d(%Array* %qubits, i64 1)
  %eq11_1 = load %Qubit*, %Qubit** (bitcast i8* %eq11_1p to %Qubit**)
  %eq11_2p = call i8* @__quantum__rt__array_get_element_ptr_1d(%Array* %qubits, i64 2)
