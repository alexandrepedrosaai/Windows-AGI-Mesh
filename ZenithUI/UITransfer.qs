  call void @__quantum__qis__swap__body(%Qubit* %q11_2, %Qubit* %q11_4)
  call void @__quantum__qis__cx__body(%Qubit* %q11_3, %Qubit* %q11_5)
  call void @__maia__qis__majorana_braid(%Qubit* %q11_0, %Qubit* %q11_1, i32 3)
