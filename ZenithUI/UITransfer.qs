@SurfaceCode.Zstab.1 = constant [17 x i1] [i1 0,i1 1,i1 0,i1 1,i1 0,i1 1,i1 0,i1 1,i1 0,i1 1,i1 0,i1 1,i1 0,i1 1,i1 0,i1 1,i1 0]
