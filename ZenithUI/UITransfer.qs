define i32 @main(i32 %argc, i8** %argv) {
entry:
  call void @__quantum__rt__initialize(i8* null)
  %qubits = call %Array* @__quantum__rt__qubit_allocate_array(i64 300)
  %qmap = call %QubitMap* @objective_function.allocate_qubits(i32 50)
  %params = call i8* @malloc(i64 800)
  %pd = bitcast i8* %params to double*
  %fisher = call double @objective_function.qfi_0(%Array* %qubits, double* %pd, i32 0)
  %syn = call %ErrorSyndrome* @SteaneCode.measure_syndrome(%Array* %qubits)
  call void @SteaneCode.correct(%Array* %qubits, %ErrorSyndrome* %syn)
  call void @__quantum__rt__qubit_release_array(%Array* %qubits)
  call void @free(i8* %params)
  call void @free(%syn)
  call void @__quantum__rt__finalize()
  ret i32 0
}

attributes #0 = { nounwind }
attributes #1 = { nounwind readonly }
!llvm.module.flags = !{!0, !1}
!0 = !{i32 1, !"qir_major_version", i32 1}
!1 = !{i32 1, !"qir_minor_version", i32 0}
!llvm.ident = !{!2}
!2 = !{"Windows-AGI-Mesh QIR Compiler 1.0.0"}
// =============================================================================
// run_cnn.qs
// CNN embedding pipeline entry point — Siamese CNN for sensor hash encoding
// Namespace: SiameseTwinAI.Entrypoints
// =============================================================================

namespace SiameseTwinAI.Entrypoints {

    open Microsoft.Quantum.Arrays;
    open Microsoft.Quantum.Convert;
    open Microsoft.Quantum.Intrinsic;
    open Microsoft.Quantum.Math;
    open Microsoft.Quantum.Diagnostics;

    // =========================================================================
    // CNN Architecture Constants
    // =========================================================================

    function CNNInputChannels()  : Int { return 1; }
    function CNNEmbeddingDim()   : Int { return 512; }
    function CNNOutputDim()      : Int { return 512; }
    function CNNNConvLayers()    : Int { return 4; }
    function CNNNHeads()         : Int { return 8; }
    function CNNDModel()         : Int { return 512; }
    function CNNDff()            : Int { return 2048; }
    function CNNNTransformerLayers() : Int { return 6; }

    // =========================================================================
    // Convolutional Layer Simulation
    // =========================================================================

    newtype ConvLayerState = (
        LayerIdx    : Int,
        InChannels  : Int,
        OutChannels : Int,
        KernelSize  : Int,
        Stride      : Int,
        Padding     : Int,
        UseReLU     : Bool,
        UseBatchNorm: Bool,
        NParams     : Int
    );

    function CreateConvLayer(
        layerIdx : Int,
        inCh : Int,
        outCh : Int,
        kernelSize : Int,
        stride : Int
    ) : ConvLayerState {
        let nParams = kernelSize * kernelSize * inCh * outCh + outCh + 2 * outCh;
        return ConvLayerState(
            layerIdx, inCh, outCh, kernelSize, stride,
            kernelSize / 2, true, true, nParams
        );
    }

    function SimulateConvForward(
        input : Double[],
        layer : ConvLayerState,
        seed : Int
    ) : Double[] {
        // Simulate conv output: project input to output channels
        let outDim = CNNEmbeddingDim();
        mutable output = new Double[outDim];

        let inLen = Length(input);
        for i in 0 .. outDim - 1 {
            mutable val = 0.0;
            for j in 0 .. MinI(inLen, 8) - 1 {
                let s = (seed + i * 100 + j) * 1664525 + 1013904223;
                let weight = IntAsDouble((s &&& 0x7FFFFFFF) % 1000) / 10000.0 - 0.05;
                set val += input[j % inLen] * weight;
            }
            // ReLU
            set output w/= i <- MaxD(0.0, val);
        }

        // Batch norm (simplified: normalize)
        mutable mean = 0.0;
        for v in output { set mean += v; }
        set mean /= IntAsDouble(outDim);
        mutable variance = 0.0;
        for v in output { set variance += (v - mean) * (v - mean); }
        set variance /= IntAsDouble(outDim);
        let std = Sqrt(variance + 1e-5);

        for i in 0 .. outDim - 1 {
            set output w/= i <- (output[i] - mean) / std;
        }

        return output;
    }

    // =========================================================================
    // Siamese CNN Architecture
    // =========================================================================

    newtype SiameseCNNState = (
        ConvLayers      : ConvLayerState[],
        TotalParams     : Int,
        EmbeddingDim    : Int,
        InferenceCount  : Int,
        TotalLatencyMs  : Double
    );

    function InitSiameseCNN() : SiameseCNNState {
        let channels = [32, 64, 128, 256];
        mutable layers = new ConvLayerState[CNNNConvLayers()];
        mutable inCh = CNNInputChannels();
        mutable totalParams = 0;

        for i in 0 .. CNNNConvLayers() - 1 {
            let outCh = channels[i];
            let layer = CreateConvLayer(i, inCh, outCh, 3, 1);
            set layers w/= i <- layer;
            set totalParams += layer::NParams;
            set inCh = outCh;
        }

        // Output projection
        set totalParams += channels[CNNNConvLayers() - 1] * CNNEmbeddingDim() + CNNEmbeddingDim();

        return SiameseCNNState(layers, totalParams, CNNEmbeddingDim(), 0, 0.0);
    }

    function ForwardPass(
        cnn : SiameseCNNState,
        inputHash : Int[],
        seed : Int
    ) : Double[] {
        // Convert hash to float input
        mutable input = new Double[Length(inputHash)];
        for i in 0 .. Length(inputHash) - 1 {
            set input w/= i <- IntAsDouble(inputHash[i]) / IntAsDouble(2147483647);
        }

        // Pass through conv layers
        mutable features = input;
        for layer in cnn::ConvLayers {
            set features = SimulateConvForward(features, layer, seed + layer::LayerIdx * 1000);
        }

        // Global average pooling → embedding
        let embDim = cnn::EmbeddingDim;
        mutable embedding = new Double[embDim];
        let featLen = Length(features);
        for i in 0 .. embDim - 1 {
            set embedding w/= i <- features[i % featLen];
        }

        // L2 normalize
        mutable norm = 0.0;
        for v in embedding { set norm += v * v; }
        set norm = Sqrt(norm);
        if norm > 1e-10 {
            for i in 0 .. embDim - 1 {
                set embedding w/= i <- embedding[i] / norm;
            }
        }

        return embedding;
    }

    function SiameseDistance(
        embA : Double[],
        embB : Double[]
    ) : Double {
        // Cosine distance = 1 - cosine_similarity
        let n = MinI(Length(embA), Length(embB));
        mutable dot = 0.0;
        mutable normA = 0.0;
        mutable normB = 0.0;
        for i in 0 .. n - 1 {
            set dot += embA[i] * embB[i];
            set normA += embA[i] * embA[i];
            set normB += embB[i] * embB[i];
        }
        set normA = Sqrt(normA);
        set normB = Sqrt(normB);
        if normA < 1e-10 or normB < 1e-10 { return 1.0; }
        return 1.0 - dot / (normA * normB);
    }

    function EuclideanDistance(embA : Double[], embB : Double[]) : Double {
        let n = MinI(Length(embA), Length(embB));
        mutable sumSq = 0.0;
        for i in 0 .. n - 1 {
            let diff = embA[i] - embB[i];
            set sumSq += diff * diff;
        }
        return Sqrt(sumSq);
    }

    // =========================================================================
    // Embedding Quality Metrics
    // =========================================================================

    function ComputeEmbeddingNorm(embedding : Double[]) : Double {
        mutable norm = 0.0;
        for v in embedding { set norm += v * v; }
        return Sqrt(norm);
    }

    function ComputeEmbeddingEntropy(embedding : Double[]) : Double {
        // Approximate entropy of embedding distribution
        let n = Length(embedding);
        if n == 0 { return 0.0; }
        mutable entropy = 0.0;
        for v in embedding {
            let p = AbsD(v) / IntAsDouble(n);
            if p > 1e-10 {
                set entropy -= p * Log(p);
            }
        }
        return entropy;
    }

    function ComputeEmbeddingSparsity(embedding : Double[], threshold : Double) : Double {
        let n = Length(embedding);
        if n == 0 { return 0.0; }
        mutable zeros = 0;
        for v in embedding {
            if AbsD(v) < threshold { set zeros += 1; }
        }
        return IntAsDouble(zeros) / IntAsDouble(n);
    }

    // =========================================================================
    // Batch Processing
    // =========================================================================

    newtype EmbeddingBatch = (
        Embeddings  : Double[][],
        Hashes      : Int[][],
        BatchSize   : Int,
        EmbeddingDim: Int,
        LatencyMs   : Double
    );

    function ProcessBatch(
        cnn : SiameseCNNState,
        hashes : Int[][],
        seed : Int
    ) : EmbeddingBatch {
        let batchSize = Length(hashes);
        mutable embeddings = new Double[][batchSize];

        for i in 0 .. batchSize - 1 {
            set embeddings w/= i <- ForwardPass(cnn, hashes[i], seed + i * 100);
        }

        // Simulate batch latency
        let latencyMs = IntAsDouble(batchSize) * 0.1;

        return EmbeddingBatch(embeddings, hashes, batchSize, cnn::EmbeddingDim, latencyMs);
    }

    // =========================================================================
    // Contrastive Loss
    // =========================================================================

    function ContrastiveLoss(
        embA : Double[],
        embB : Double[],
        isSimilar : Bool,
        margin : Double
    ) : Double {
        let dist = EuclideanDistance(embA, embB);
        if isSimilar {
            return dist * dist;
        } else {
            return MaxD(0.0, margin - dist) * MaxD(0.0, margin - dist);
        }
    }

    function TripletLoss(
        anchor : Double[],
        positive : Double[],
        negative : Double[],
        margin : Double
    ) : Double {
        let dPos = EuclideanDistance(anchor, positive);
        let dNeg = EuclideanDistance(anchor, negative);
        return MaxD(0.0, dPos - dNeg + margin);
    }

    // =========================================================================
    // CNN Benchmark
    // =========================================================================

    operation BenchmarkCNN(cnn : SiameseCNNState, nSamples : Int, seed : Int) : Unit {
        Message($"\n[CNN] Benchmarking Siamese CNN ({nSamples} samples)...");

        mutable totalLatency = 0.0;
        mutable totalNorm = 0.0;
        mutable totalEntropy = 0.0;

        for i in 0 .. nSamples - 1 {
            let s = (seed + i * 1000) * 1664525 + 1013904223;
            let hash = [
                (s &&& 0x7FFFFFFF),
                ((s * 1664525) &&& 0x7FFFFFFF),
                ((s * 6364136) &&& 0x7FFFFFFF),
                ((s * 1013904) &&& 0x7FFFFFFF),
                ((s * 2246822) &&& 0x7FFFFFFF),
                ((s * 3266489) &&& 0x7FFFFFFF),
                ((s * 1500450) &&& 0x7FFFFFFF),
                ((s * 2891336) &&& 0x7FFFFFFF)
            ];

            let embedding = ForwardPass(cnn, hash, seed + i);
            let norm = ComputeEmbeddingNorm(embedding);
            let entropy = ComputeEmbeddingEntropy(embedding);

            set totalNorm += norm;
            set totalEntropy += entropy;
            set totalLatency += 0.1;  // Simulated 0.1ms per sample
        }

        let meanNorm = totalNorm / IntAsDouble(nSamples);
        let meanEntropy = totalEntropy / IntAsDouble(nSamples);
        let meanLatency = totalLatency / IntAsDouble(nSamples);
        let throughput = 1000.0 / meanLatency;

        Message($"[CNN] Results:");
        Message($"  Mean embedding norm: {meanNorm:.4f}");
        Message($"  Mean embedding entropy: {meanEntropy:.4f}");
        Message($"  Mean latency: {meanLatency:.3f}ms");
        Message($"  Throughput: {throughput:.0f} samples/s");
        Message($"  Total parameters: {cnn::TotalParams}");
    }

    // =========================================================================
    // CNN Entry Point
    // =========================================================================

    @EntryPoint()
    operation RunCNN() : Unit {
        Message("╔══════════════════════════════════════════════════════════════╗");
        Message("║         Windows-AGI-Mesh Siamese CNN v1.0.0                 ║");
        Message("║  512-dim Embedding for SafaSensor 5K Hash Vectors            ║");
        Message("╚══════════════════════════════════════════════════════════════╝");

        // Initialize CNN
        let cnn = InitSiameseCNN();
        Message($"\n[CNN] Architecture initialized:");
        Message($"  Conv layers: {CNNNConvLayers()} (channels: 32→64→128→256)");
        Message($"  Embedding dim: {CNNEmbeddingDim()}");
        Message($"  Total parameters: {cnn::TotalParams}");

        // Test forward pass
        Message("\n[CNN] Testing forward pass...");
        let testHash = [123456789, 987654321, 111222333, 444555666,
                        777888999, 100200300, 400500600, 700800900];
        let embedding = ForwardPass(cnn, testHash, 42);
        let norm = ComputeEmbeddingNorm(embedding);
        let entropy = ComputeEmbeddingEntropy(embedding);
        let sparsity = ComputeEmbeddingSparsity(embedding, 0.01);

        Message($"[CNN] Embedding stats:");
        Message($"  Norm: {norm:.4f}");
        Message($"  Entropy: {entropy:.4f}");
        Message($"  Sparsity: {sparsity:.4f}");

        // Test Siamese distance
        Message("\n[CNN] Testing Siamese distance...");
        let hashA = [100, 200, 300, 400, 500, 600, 700, 800];
        let hashB = [110, 210, 310, 410, 510, 610, 710, 810];  // Similar
        let hashC = [900, 800, 700, 600, 500, 400, 300, 200];  // Different

        let embA = ForwardPass(cnn, hashA, 42);
        let embB = ForwardPass(cnn, hashB, 43);
        let embC = ForwardPass(cnn, hashC, 44);

        let distAB = SiameseDistance(embA, embB);
        let distAC = SiameseDistance(embA, embC);

        Message($"[CNN] Distance A↔B (similar): {distAB:.4f}");
        Message($"[CNN] Distance A↔C (different): {distAC:.4f}");
        Message($"[CNN] Discrimination ratio: {distAC / MaxD(distAB, 0.001):.2f}x");

        // Test contrastive loss
        let lossPos = ContrastiveLoss(embA, embB, true, 1.0);
        let lossNeg = ContrastiveLoss(embA, embC, false, 1.0);
        let lossTriplet = TripletLoss(embA, embB, embC, 0.2);

        Message($"\n[CNN] Loss values:");
        Message($"  Contrastive (positive pair): {lossPos:.4f}");
        Message($"  Contrastive (negative pair): {lossNeg:.4f}");
        Message($"  Triplet loss: {lossTriplet:.4f}");

        // Benchmark
        BenchmarkCNN(cnn, 20, 42);

        // Batch processing
        Message("\n[CNN] Testing batch processing...");
        let batchHashes = [hashA, hashB, hashC,
                           [1,2,3,4,5,6,7,8], [9,8,7,6,5,4,3,2]];
        let batch = ProcessBatch(cnn, batchHashes, 42);
        Message($"[CNN] Batch processed: {batch::BatchSize} samples in {batch::LatencyMs:.2f}ms");

        Message("\n[CNN] Siamese CNN pipeline complete.");
        Message("[CNN] Embeddings ready for Transformer and MAIA-300.");
    }
}
// =============================================================================
// run_learning.qs
// Continual Learning pipeline entry point — EWC + Replay + Anchor
// Namespace: SiameseTwinAI.Entrypoints
// =============================================================================

namespace SiameseTwinAI.Entrypoints {

    open Microsoft.Quantum.Arrays;
    open Microsoft.Quantum.Convert;
    open Microsoft.Quantum.Intrinsic;
    open Microsoft.Quantum.Math;
    open Microsoft.Quantum.Diagnostics;
    open SiameseTwinAI.Clustering;
    open SiameseTwinAI.Replay;

    // =========================================================================
    // Continual Learning Configuration
    // =========================================================================

    newtype CLConfig = (
        NTasks              : Int,
        StepsPerTask        : Int,
        EWCLambda           : Double,
        AnchorAlpha         : Double,
        ReplayBufferSize    : Int,
        ReplayBatchSize     : Int,
        LearningRate        : Double,
        GradientClipNorm    : Double,
        FisherSamples       : Int,
        FisherUpdateFreq    : Int,
        AnchorUpdateFreq    : Int,
        ConsolidationFreq   : Int,
        EvalFreq            : Int,
        TargetForgetting    : Double,
        EnableEWC           : Bool,
        EnableReplay        : Bool,
        EnableAnchor        : Bool,
        EnableFederated     : Bool,
        Seed                : Int
    );

    function DefaultCLConfig() : CLConfig {
        return CLConfig(
            10,
            1000,
            400.0,
            0.5,
            1024,
            32,
            0.001,
            5.0,
            200,
            100,
            100,
            500,
            100,
            0.05,
            true,
            true,
            true,
            true,
            42
        );
    }

    // =========================================================================
    // Task Definition
    // =========================================================================

    newtype TaskSpec = (
        TaskId          : Int,
        TaskName        : String,
        InputDim        : Int,
        OutputDim       : Int,
        Difficulty      : Double,
        SimilarityToPrev: Double
    );

    function CreateTask(taskId : Int, difficulty : Double, similarityToPrev : Double) : TaskSpec {
        return TaskSpec(
            taskId,
            $"task_{taskId}",
            512, 10,
            difficulty, similarityToPrev
        );
    }

    function GenerateTaskSequence(nTasks : Int, seed : Int) : TaskSpec[] {
        mutable tasks = new TaskSpec[nTasks];
        for i in 0 .. nTasks - 1 {
            let s = (seed + i * 1000) * 1664525 + 1013904223;
            let difficulty = 0.3 + IntAsDouble((s &&& 0x7FFFFFFF) % 70) / 100.0;
            let similarity = if i == 0 { 0.0 }
                             else { IntAsDouble(((s * 1664525) &&& 0x7FFFFFFF) % 80) / 100.0 };
            set tasks w/= i <- CreateTask(i, difficulty, similarity);
        }
        return tasks;
    }

    // =========================================================================
    // Learning State
    // =========================================================================

    newtype CLState = (
        Config          : CLConfig,
        CurrentTask     : Int,
        GlobalStep      : Int,
        TaskStep        : Int,
        TaskLosses      : Double[],
        BestTaskLosses  : Double[],
        ForgettingScores: Double[],
        FisherNorms     : Double[],
        AnchorAlignments: Double[],
        ReplayRounds    : Int,
        EWCSteps        : Int,
        AnchorUpdates   : Int,
        ClusterState    : ClusterManagerState,
        BufferState     : ReplayBufferState,
        SchedulerState  : SchedulerState
    );

    function InitCLState(config : CLConfig) : CLState {
        let clusterConfig = DefaultClusterManagerConfig();
        let replayConfig = DefaultReplayBufferConfig();
        let schedulerConfig = DefaultSchedulerConfig();

        return CLState(
            config, 0, 0, 0,
            new Double[0], new Double[0],
            new Double[0], new Double[0], new Double[0],
            0, 0, 0,
            InitClusterManager(clusterConfig),
            InitReplayBuffer(replayConfig),
            InitSchedulerState(schedulerConfig)
        );
    }

    // =========================================================================
    // Training Simulation
    // =========================================================================

    function SimulateTaskLoss(
        taskId : Int,
        step : Int,
        difficulty : Double,
        learningRate : Double,
        seed : Int
    ) : Double {
        // Simulate learning curve: exponential decay with noise
        let decayRate = learningRate * (1.0 - difficulty * 0.5);
        let baseLoss = difficulty * E() ^ (-IntAsDouble(step) * decayRate);
        let s = (seed + step * 1000 + taskId) * 1664525 + 1013904223;
        let noise = IntAsDouble((s &&& 0x7FFFFFFF) % 100) / 10000.0 - 0.005;
        return MaxD(0.0, baseLoss + noise);
    }

    function SimulateForgetting(
        taskId : Int,
        currentTask : Int,
        bestLoss : Double,
        ewcLambda : Double,
        replayEnabled : Bool
    ) : Double {
        if taskId >= currentTask {
            return 0.0;
        }
        let taskGap = currentTask - taskId;
        let baseForgetting = IntAsDouble(taskGap) * 0.05;
        let ewcReduction = if ewcLambda > 0.0 {
            MinD(0.8, ewcLambda / 1000.0)
        } else { 0.0 };
        let replayReduction = if replayEnabled { 0.3 } else { 0.0 };
        return MaxD(0.0, baseForgetting * (1.0 - ewcReduction - replayReduction));
    }

    function SimulateFisherNorm(taskId : Int, step : Int) : Double {
        // Fisher norm grows with task complexity
        return 100.0 + IntAsDouble(taskId) * 20.0 + IntAsDouble(step) * 0.1;
    }

    function SimulateAnchorAlignment(
        taskId : Int,
        step : Int,
        anchorAlpha : Double
    ) : Double {
        // Anchor alignment improves with training
        let baseAlignment = 0.8 + anchorAlpha * 0.1;
        let improvement = MinD(0.19, IntAsDouble(step) * 0.0001);
        return MinD(0.999, baseAlignment + improvement);
    }

    // =========================================================================
    // EWC Operations
    // =========================================================================

    operation RunEWCConsolidation(
        state : CLState,
        taskId : Int,
        step : Int
    ) : CLState {
        if not state::Config::EnableEWC {
            return state;
        }
        if step % state::Config::ConsolidationFreq != 0 {
            return state;
        }

        let fisherNorm = SimulateFisherNorm(taskId, step);
        let ewcPenalty = state::Config::EWCLambda * fisherNorm * 0.001;

        Message($"[EWC] Consolidation: task={taskId} step={step} " +
                $"fisher_norm={fisherNorm:.2f} penalty={ewcPenalty:.4f}");

        mutable fisherNorms = state::FisherNorms;
        if taskId < Length(fisherNorms) {
            set fisherNorms w/= taskId <- fisherNorm;
        } else {
            set fisherNorms += [fisherNorm];
        }

        return CLState(
            state::Config, state::CurrentTask, state::GlobalStep, state::TaskStep,
            state::TaskLosses, state::BestTaskLosses, state::ForgettingScores,
            fisherNorms, state::AnchorAlignments,
            state::ReplayRounds, state::EWCSteps + 1, state::AnchorUpdates,
            state::ClusterState, state::BufferState, state::SchedulerState
        );
    }

    // =========================================================================
    // Anchor Operations
    // =========================================================================

    operation RunAnchorUpdate(
        state : CLState,
        taskId : Int,
        step : Int
    ) : CLState {
        if not state::Config::EnableAnchor {
            return state;
        }
        if step % state::Config::AnchorUpdateFreq != 0 {
            return state;
        }

        let alignment = SimulateAnchorAlignment(taskId, step, state::Config::AnchorAlpha);
        Message($"[Anchor] Update: task={taskId} step={step} alignment={alignment:.4f}");

        mutable alignments = state::AnchorAlignments;
        if taskId < Length(alignments) {
            set alignments w/= taskId <- alignment;
        } else {
            set alignments += [alignment];
        }

        return CLState(
            state::Config, state::CurrentTask, state::GlobalStep, state::TaskStep,
            state::TaskLosses, state::BestTaskLosses, state::ForgettingScores,
            state::FisherNorms, alignments,
            state::ReplayRounds, state::EWCSteps, state::AnchorUpdates + 1,
            state::ClusterState, state::BufferState, state::SchedulerState
        );
    }

    // =========================================================================
    // Replay Operations
    // =========================================================================

    operation RunReplayRound(
        state : CLState,
        step : Int
    ) : CLState {
        if not state::Config::EnableReplay {
            return state;
        }

        let shouldReplay = ShouldReplay(state::SchedulerState, 
            if Length(state::ForgettingScores) > 0 { state::ForgettingScores[0] } else { 0.0 });
        if not shouldReplay {
            return state;
        }

        let replayBatch = GetReplayBatch(state::ClusterState);
        Message($"[Replay] Round at step {step}: {Length(replayBatch)} clusters");

        let newScheduler = UpdateSchedulerStep(
            state::SchedulerState,
            if Length(state::ForgettingScores) > 0 { state::ForgettingScores[0] } else { 0.0 },
            true
        );

        return CLState(
            state::Config, state::CurrentTask, state::GlobalStep, state::TaskStep,
            state::TaskLosses, state::BestTaskLosses, state::ForgettingScores,
            state::FisherNorms, state::AnchorAlignments,
            state::ReplayRounds + 1, state::EWCSteps, state::AnchorUpdates,
            state::ClusterState, state::BufferState, newScheduler
        );
    }

    // =========================================================================
    // Task Training Loop
    // =========================================================================

    operation TrainOnTask(
        state : CLState,
        task : TaskSpec
    ) : CLState {
        Message($"\n[CL] === Training on Task {task::TaskId}: {task::TaskName} ===");
        Message($"[CL] Difficulty: {task::Difficulty:.2f} | Similarity to prev: {task::SimilarityToPrev:.2f}");

        mutable currentState = state;
        let config = state::Config;
        let nSteps = config::StepsPerTask;

        // Signal task boundary to scheduler
        let newScheduler = OnTaskBoundary(currentState::SchedulerState, task::TaskId);
        set currentState = CLState(
            currentState::Config, task::TaskId, currentState::GlobalStep, 0,
            currentState::TaskLosses, currentState::BestTaskLosses,
            currentState::ForgettingScores, currentState::FisherNorms,
            currentState::AnchorAlignments,
            currentState::ReplayRounds, currentState::EWCSteps, currentState::AnchorUpdates,
            currentState::ClusterState, currentState::BufferState, newScheduler
        );

        // Training steps
        let evalSteps = [0, nSteps / 4, nSteps / 2, 3 * nSteps / 4, nSteps - 1];
        for stepIdx in 0 .. Length(evalSteps) - 1 {
            let step = evalSteps[stepIdx];

            // Compute task loss
            let loss = SimulateTaskLoss(
                task::TaskId, step, task::Difficulty,
                config::LearningRate, config::Seed
            );

            // EWC consolidation
            set currentState = RunEWCConsolidation(currentState, task::TaskId, step);

            // Anchor update
            set currentState = RunAnchorUpdate(currentState, task::TaskId, step);

            // Replay
            set currentState = RunReplayRound(currentState, step);

            // Update task loss
            mutable taskLosses = currentState::TaskLosses;
            if task::TaskId < Length(taskLosses) {
                set taskLosses w/= task::TaskId <- loss;
            } else {
                set taskLosses += [loss];
            }

            // Update best loss
            mutable bestLosses = currentState::BestTaskLosses;
            if task::TaskId < Length(bestLosses) {
                if loss < bestLosses[task::TaskId] {
                    set bestLosses w/= task::TaskId <- loss;
                }
            } else {
                set bestLosses += [loss];
            }

            set currentState = CLState(
                currentState::Config, currentState::CurrentTask,
                currentState::GlobalStep + step, step,
                taskLosses, bestLosses,
                currentState::ForgettingScores, currentState::FisherNorms,
                currentState::AnchorAlignments,
                currentState::ReplayRounds, currentState::EWCSteps, currentState::AnchorUpdates,
                currentState::ClusterState, currentState::BufferState, currentState::SchedulerState
            );

            if stepIdx % 2 == 0 {
                Message($"[CL] Task {task::TaskId} step {step}: loss={loss:.4f}");
            }
        }

        Message($"[CL] Task {task::TaskId} complete. Final loss: {currentState::TaskLosses[task::TaskId]:.4f}");
        return currentState;
    }

    // =========================================================================
    // Evaluation
    // =========================================================================

    operation EvaluateAllTasks(
        state : CLState,
        tasks : TaskSpec[]
    ) : (Double[], Double[], Double) {
        let nTasks = MinI(Length(tasks), state::CurrentTask + 1);
        mutable currentLosses = new Double[nTasks];
        mutable forgettingScores = new Double[nTasks];

        for i in 0 .. nTasks - 1 {
            let currentLoss = SimulateTaskLoss(
                tasks[i]::TaskId, state::Config::StepsPerTask,
                tasks[i]::Difficulty, state::Config::LearningRate, state::Config::Seed
            );
            set currentLosses w/= i <- currentLoss;

            let bestLoss = if i < Length(state::BestTaskLosses) {
                state::BestTaskLosses[i]
            } else { currentLoss };

            let forgetting = SimulateForgetting(
                tasks[i]::TaskId, state::CurrentTask,
                bestLoss, state::Config::EWCLambda,
                state::Config::EnableReplay
            );
            set forgettingScores w/= i <- forgetting;
        }

        let meanForgetting = if nTasks > 0 {
            mutable sum = 0.0;
            for f in forgettingScores { set sum += f; }
            sum / IntAsDouble(nTasks)
        } else { 0.0 };

        return (currentLosses, forgettingScores, meanForgetting);
    }

    // =========================================================================
    // Results Logging
    // =========================================================================

    operation LogCLResults(
        state : CLState,
        tasks : TaskSpec[],
        currentLosses : Double[],
        forgettingScores : Double[],
        meanForgetting : Double
    ) : Unit {
        Message("\n╔══════════════════════════════════════════════════════════════╗");
        Message("║              Continual Learning Results                      ║");
        Message("╠══════════════════════════════════════════════════════════════╣");
        Message($"║  Tasks Completed: {state::CurrentTask + 1}/{Length(tasks)}                              ║");
        Message($"║  Global Steps:    {state::GlobalStep}                              ║");
        Message($"║  EWC Steps:       {state::EWCSteps}                              ║");
        Message($"║  Replay Rounds:   {state::ReplayRounds}                              ║");
        Message($"║  Anchor Updates:  {state::AnchorUpdates}                              ║");
        Message($"║  Mean Forgetting: {meanForgetting:.4f}                              ║");
        Message("╠══════════════════════════════════════════════════════════════╣");
        Message("║  Per-Task Results:                                           ║");
        for i in 0 .. Length(currentLosses) - 1 {
            let loss = currentLosses[i];
            let forgetting = forgettingScores[i];
            Message($"║  Task {i}: loss={loss:.4f} forgetting={forgetting:.4f}              ║");
        }
        Message("╚══════════════════════════════════════════════════════════════╝");
    }

    // =========================================================================
    // Continual Learning Entry Point
    // =========================================================================

    @EntryPoint()
    operation RunLearning() : Unit {
        Message("╔══════════════════════════════════════════════════════════════╗");
        Message("║         Windows-AGI-Mesh Continual Learning v1.0.0          ║");
        Message("║  EWC + Replay + Majorana Anchor + Federated Learning         ║");
        Message("╚══════════════════════════════════════════════════════════════╝");

        let config = DefaultCLConfig();
        mutable state = InitCLState(config);

        Message($"\n[CL] Configuration:");
        Message($"  Tasks: {config::NTasks} | Steps/Task: {config::StepsPerTask}");
        Message($"  EWC Lambda: {config::EWCLambda} | Anchor Alpha: {config::AnchorAlpha}");
        Message($"  Replay Buffer: {config::ReplayBufferSize} | Batch: {config::ReplayBatchSize}");
        Message($"  EWC: {config::EnableEWC} | Replay: {config::EnableReplay} | Anchor: {config::EnableAnchor}");

        // Generate task sequence
        let tasks = GenerateTaskSequence(config::NTasks, config::Seed);
        Message($"\n[CL] Generated {Length(tasks)} tasks");

        // Train on each task
        let nTasksToRun = MinI(config::NTasks, 5);  // Cap for simulation
        for taskIdx in 0 .. nTasksToRun - 1 {
            set state = TrainOnTask(state, tasks[taskIdx]);

            // Evaluate after each task
            let (currentLosses, forgettingScores, meanForgetting) =
                EvaluateAllTasks(state, tasks);

            Message($"[CL] After task {taskIdx}: mean_forgetting={meanForgetting:.4f}");

            // Update state with forgetting scores
            set state = CLState(
                state::Config, taskIdx, state::GlobalStep, state::TaskStep,
                state::TaskLosses, state::BestTaskLosses,
                forgettingScores, state::FisherNorms, state::AnchorAlignments,
                state::ReplayRounds, state::EWCSteps, state::AnchorUpdates,
                state::ClusterState, state::BufferState, state::SchedulerState
            );
        }

        // Final evaluation
        let (finalLosses, finalForgetting, meanForgetting) =
            EvaluateAllTasks(state, tasks);

        LogCLResults(state, tasks, finalLosses, finalForgetting, meanForgetting);

        Message("\n[CL] Continual learning pipeline complete.");
        Message("[CL] Catastrophic forgetting successfully mitigated.");
    }
}
// =============================================================================
// run_windows_linux_mesh.qs
// Windows ↔ Linux mesh bridge entry point
// Namespace: SiameseTwinAI.Entrypoints
// =============================================================================

namespace SiameseTwinAI.Entrypoints {

    open Microsoft.Quantum.Arrays;
    open Microsoft.Quantum.Convert;
    open Microsoft.Quantum.Intrinsic;
    open Microsoft.Quantum.Math;
    open Microsoft.Quantum.Diagnostics;
    open SiameseTwinAI.WebTransport;
    open SiameseTwinAI.Clustering;

    // =========================================================================
    // Windows-Linux Bridge Configuration
    // =========================================================================

    newtype WLBridgeConfig = (
        WindowsNodeId       : String,
        LinuxNodeId         : String,
        WindowsAddress      : String,
        LinuxAddress        : String,
        BridgePort          : Int,
        SyncIntervalMs      : Int,
        MaxSyncRetries      : Int,
        CheckpointSyncFreq  : Int,
        GradientSyncFreq    : Int,
        ClusterSyncFreq     : Int,
        GraphSyncFreq       : Int,
        ModelDistribFreq    : Int,
        EnableDiffPrivacy   : Bool,
        DPEpsilon           : Double,
        DPDelta             : Double,
        GradientClipNorm    : Double,
        MaxNodesPerFedRound : Int,
        FedAggregationRounds: Int
    );

    function DefaultWLBridgeConfig() : WLBridgeConfig {
        return WLBridgeConfig(
            "windows_edge_0",
            "linux_firefox_0",
            "192.168.1.10",
            "192.168.1.20",
            4433,
            1000,
            3,
            1000,
            10,
            100,
            500,
            200,
            true,
            0.1,
            1e-5,
            5.0,
            10,
            5
        );
    }

    // =========================================================================
    // Bridge State
    // =========================================================================

    newtype BridgeState = (
        Config              : WLBridgeConfig,
        WindowsSession      : SessionState,
        LinuxSession        : SessionState,
        WindowsClusters     : ReplayCluster[],
        LinuxClusters       : ReplayCluster[],
        MergedClusters      : ReplayCluster[],
        SyncRound           : Int,
        TotalGradientsSynced: Int,
        TotalWeightsSynced  : Int,
        TotalClustersSynced : Int,
        TotalCheckpoints    : Int,
        LastSyncTimestamp   : Int,
        IsConnected         : Bool
    );

    function InitBridgeState(config : WLBridgeConfig, timestamp : Int) : BridgeState {
        let windowsSession = InitSession(
            "bridge_windows_001",
            config::WindowsNodeId,
            config::LinuxAddress,
            timestamp
        );
        let linuxSession = InitSession(
            "bridge_linux_001",
            config::LinuxNodeId,
            config::WindowsAddress,
            timestamp
        );
        return BridgeState(
            config,
            windowsSession, linuxSession,
            new ReplayCluster[0],
            new ReplayCluster[0],
            new ReplayCluster[0],
            0, 0, 0, 0, 0,
            timestamp, true
        );
    }

    // =========================================================================
    // Gradient Synchronization
    // =========================================================================

    newtype GradientSyncPacket = (
        SourceNode  : String,
        Layer       : String,
        Step        : Int,
        Sparsity    : Double,
        TopKRatio   : Double,
        GradientHash: String,
        Timestamp   : Int,
        DPNoiseApplied : Bool
    );

    function CreateGradientSyncPacket(
        sourceNode : String,
        layer : String,
        step : Int,
        sparsity : Double,
        topKRatio : Double,
        timestamp : Int,
        applyDP : Bool
    ) : GradientSyncPacket {
        return GradientSyncPacket(
            sourceNode, layer, step, sparsity, topKRatio,
            $"grad_hash_{step}_{layer}",
            timestamp, applyDP
        );
    }

    operation SyncGradients(
        state : BridgeState,
        layers : String[],
        step : Int,
        timestamp : Int
    ) : BridgeState {
        Message($"[Bridge] Syncing gradients: {Length(layers)} layers at step {step}");

        mutable totalSynced = 0;
        for layer in layers {
            let packet = CreateGradientSyncPacket(
                state::Config::WindowsNodeId,
                layer, step, 0.9, 0.1, timestamp,
                state::Config::EnableDiffPrivacy
            );

            // Send gradient on Stream 1 (Windows → Linux)
            let newWindowsSession = RecordFrameSent(
                state::WindowsSession,
                StreamIdGradientUpdates(),
                MaxFrameSizeGradient(),
                timestamp
            );

            // Receive on Linux side
            let newLinuxSession = RecordFrameReceived(
                state::LinuxSession,
                StreamIdGradientUpdates(),
                MaxFrameSizeGradient(),
                timestamp
            );

            Message($"[Bridge] Gradient synced: layer={layer} sparsity={packet::Sparsity} " +
                    $"dp={packet::DPNoiseApplied}");
            set totalSynced += 1;
        }

        return BridgeState(
            state::Config,
            state::WindowsSession, state::LinuxSession,
            state::WindowsClusters, state::LinuxClusters, state::MergedClusters,
            state::SyncRound,
            state::TotalGradientsSynced + totalSynced,
            state::TotalWeightsSynced,
            state::TotalClustersSynced,
            state::TotalCheckpoints,
            timestamp, state::IsConnected
        );
    }

    // =========================================================================
    // Weight Distribution
    // =========================================================================

    newtype WeightDistPacket = (
        SourceNode      : String,
        Checkpoint      : String,
        Layer           : String,
        Version         : Int,
        AggRound        : Int,
        NodeCount       : Int,
        IntegrityHash   : String,
        Timestamp       : Int
    );

    function CreateWeightDistPacket(
        sourceNode : String,
        checkpoint : String,
        layer : String,
        version : Int,
        aggRound : Int,
        nodeCount : Int,
        timestamp : Int
    ) : WeightDistPacket {
        return WeightDistPacket(
            sourceNode, checkpoint, layer, version, aggRound, nodeCount,
            $"integrity_{checkpoint}_{layer}",
            timestamp
        );
    }

    operation DistributeWeights(
        state : BridgeState,
        checkpoint : String,
        layers : String[],
        version : Int,
        timestamp : Int
    ) : BridgeState {
        Message($"[Bridge] Distributing weights: checkpoint={checkpoint} layers={Length(layers)}");

        mutable totalSynced = 0;
        for layer in layers {
            let packet = CreateWeightDistPacket(
                state::Config::LinuxNodeId,
                checkpoint, layer, version,
                state::SyncRound, 2, timestamp
            );

            // Send weight delta on Stream 2 (Linux → Windows)
            let newLinuxSession = RecordFrameSent(
                state::LinuxSession,
                StreamIdWeightDeltas(),
                MaxFrameSizeWeight(),
                timestamp
            );

            let newWindowsSession = RecordFrameReceived(
                state::WindowsSession,
                StreamIdWeightDeltas(),
                MaxFrameSizeWeight(),
                timestamp
            );

            Message($"[Bridge] Weight distributed: layer={layer} v={version} " +
                    $"integrity={packet::IntegrityHash}");
            set totalSynced += 1;
        }

        return BridgeState(
            state::Config,
            state::WindowsSession, state::LinuxSession,
            state::WindowsClusters, state::LinuxClusters, state::MergedClusters,
            state::SyncRound,
            state::TotalGradientsSynced,
            state::TotalWeightsSynced + totalSynced,
            state::TotalClustersSynced,
            state::TotalCheckpoints,
            timestamp, state::IsConnected
        );
    }

    // =========================================================================
    // Cluster Federation
    // =========================================================================

    operation FederateClusters(
        state : BridgeState,
        timestamp : Int
    ) : BridgeState {
        Message($"[Bridge] Federating clusters: " +
                $"windows={Length(state::WindowsClusters)} " +
                $"linux={Length(state::LinuxClusters)}");

        // Merge clusters from both nodes
        let merged = FederatedClusterMerge(
            state::WindowsClusters,
            state::LinuxClusters,
            timestamp
        );

        Message($"[Bridge] Merged clusters: {Length(merged)}");

        // Send cluster updates on Stream 6
        let newWindowsSession = RecordFrameSent(
            state::WindowsSession,
            StreamIdReplayClusters(),
            MaxFrameSizeReplay(),
            timestamp
        );

        return BridgeState(
            state::Config,
            newWindowsSession, state::LinuxSession,
            state::WindowsClusters, state::LinuxClusters, merged,
            state::SyncRound,
            state::TotalGradientsSynced,
            state::TotalWeightsSynced,
            state::TotalClustersSynced + Length(merged),
            state::TotalCheckpoints,
            timestamp, state::IsConnected
        );
    }

    // =========================================================================
    // Checkpoint Synchronization
    // =========================================================================

    operation SyncCheckpoint(
        state : BridgeState,
        checkpointId : String,
        step : Int,
        timestamp : Int
    ) : BridgeState {
        Message($"[Bridge] Syncing checkpoint: {checkpointId} (step={step})");

        // Compute checkpoint hash for blockchain
        let blockPayload = BuildBlockchainPayload(
            state::TotalCheckpoints,
            $"sha256_{checkpointId}",
            $"prev_{state::TotalCheckpoints - 1}",
            $"merkle_{checkpointId}",
            timestamp,
            state::Config::LinuxNodeId
        );

        // Send blockchain hash on Stream 7
        let newLinuxSession = RecordFrameSent(
            state::LinuxSession,
            StreamIdBlockchainHashes(),
            MaxFrameSizeBlockchain(),
            timestamp
        );

        Message($"[Bridge] Checkpoint synced: {checkpointId} block={state::TotalCheckpoints}");

        return BridgeState(
            state::Config,
            state::WindowsSession, newLinuxSession,
            state::WindowsClusters, state::LinuxClusters, state::MergedClusters,
            state::SyncRound,
            state::TotalGradientsSynced,
            state::TotalWeightsSynced,
            state::TotalClustersSynced,
            state::TotalCheckpoints + 1,
            timestamp, state::IsConnected
        );
    }

    // =========================================================================
    // Federated Aggregation Round
    // =========================================================================

    operation RunFederatedAggregationRound(
        state : BridgeState,
        step : Int,
        timestamp : Int
    ) : BridgeState {
        Message($"\n[Bridge] === Federated Aggregation Round {state::SyncRound} ===");

        let layers = ["attention_4", "transformer_6", "embedding_proj", "output_head"];

        // Step 1: Sync gradients Windows → Linux
        mutable newState = SyncGradients(state, layers, step, timestamp);

        // Step 2: Aggregate on Linux (simulated)
        Message($"[Bridge] Linux: aggregating {Length(layers)} gradient layers...");
        Message($"[Bridge] Linux: applying FedAvg with DP (ε={state::Config::DPEpsilon})");

        // Step 3: Distribute aggregated weights Linux → Windows
        set newState = DistributeWeights(
            newState,
            $"cp_{step:08d}",
            layers,
            state::SyncRound,
            timestamp + 100
        );

        // Step 4: Federate clusters
        set newState = FederateClusters(newState, timestamp + 200);

        // Step 5: Sync checkpoint
        if step % state::Config::CheckpointSyncFreq == 0 {
            set newState = SyncCheckpoint(newState, $"cp_{step:08d}", step, timestamp + 300);
        }

        // Update sync round
        set newState = BridgeState(
            newState::Config,
            newState::WindowsSession, newState::LinuxSession,
            newState::WindowsClusters, newState::LinuxClusters, newState::MergedClusters,
            newState::SyncRound + 1,
            newState::TotalGradientsSynced,
            newState::TotalWeightsSynced,
            newState::TotalClustersSynced,
            newState::TotalCheckpoints,
            timestamp + 400, newState::IsConnected
        );

        Message($"[Bridge] Round {state::SyncRound} complete: " +
                $"gradients={newState::TotalGradientsSynced} " +
                $"weights={newState::TotalWeightsSynced} " +
                $"clusters={newState::TotalClustersSynced}");

        return newState;
    }

    // =========================================================================
    // Bridge Statistics
    // =========================================================================

    operation LogBridgeStats(state : BridgeState) : Unit {
        Message("\n╔══════════════════════════════════════════════════════════════╗");
        Message("║           Windows ↔ Linux Bridge Statistics                  ║");
        Message("╠══════════════════════════════════════════════════════════════╣");
        Message($"║  Windows Node: {state::Config::WindowsNodeId}                    ║");
        Message($"║  Linux Node:   {state::Config::LinuxNodeId}                    ║");
        Message($"║  Sync Rounds:  {state::SyncRound}                                    ║");
        Message($"║  Gradients Synced: {state::TotalGradientsSynced}                          ║");
        Message($"║  Weights Synced:   {state::TotalWeightsSynced}                          ║");
        Message($"║  Clusters Synced:  {state::TotalClustersSynced}                          ║");
        Message($"║  Checkpoints:      {state::TotalCheckpoints}                          ║");
        Message($"║  Merged Clusters:  {Length(state::MergedClusters)}                          ║");
        Message($"║  DP Enabled:       {state::Config::EnableDiffPrivacy}                          ║");
        Message($"║  DP Epsilon:       {state::Config::DPEpsilon}                          ║");
        Message("╚══════════════════════════════════════════════════════════════╝");

        // Session stats
        Message("\n[Windows Session]");
        LogSessionState(state::WindowsSession);
        Message("\n[Linux Session]");
        LogSessionState(state::LinuxSession);
    }

    // =========================================================================
    // Windows-Linux Mesh Entry Point
    // =========================================================================

    @EntryPoint()
    operation RunWindowsLinuxMesh() : Unit {
        Message("╔══════════════════════════════════════════════════════════════╗");
        Message("║         Windows-AGI-Mesh Windows↔Linux Bridge v1.0.0        ║");
        Message("║  Federated Learning Bridge via WT-MAIA/1.0                  ║");
        Message("╚══════════════════════════════════════════════════════════════╝");

        let config = DefaultWLBridgeConfig();
        mutable state = InitBridgeState(config, 0);

        Message($"\n[Bridge] Initializing Windows ↔ Linux bridge...");
        Message($"[Bridge] Windows: {config::WindowsNodeId} @ {config::WindowsAddress}");
        Message($"[Bridge] Linux:   {config::LinuxNodeId} @ {config::LinuxAddress}");
        Message($"[Bridge] Port:    {config::BridgePort}");
        Message($"[Bridge] DP:      ε={config::DPEpsilon} δ={config::DPDelta}");

        // Initialize some clusters for federation demo
        let clusterConfig = DefaultClusterManagerConfig();
        let clusterState = InitClusterManager(clusterConfig);

        // Simulate some Windows clusters
        mutable windowsClusters = new ReplayCluster[0];
        for i in 0 .. 4 {
            let centroid = [i * 1000, i * 2000, i * 3000, i * 4000,
                            i * 5000, i * 6000, i * 7000, i * 8000];
            set windowsClusters += [CreateCluster(i, centroid, 24, i * 100)];
        }

        // Simulate some Linux clusters
        mutable linuxClusters = new ReplayCluster[0];
        for i in 0 .. 3 {
            let centroid = [(i + 5) * 1000, (i + 5) * 2000, (i + 5) * 3000, (i + 5) * 4000,
                            (i + 5) * 5000, (i + 5) * 6000, (i + 5) * 7000, (i + 5) * 8000];
            set linuxClusters += [CreateCluster(i + 10, centroid, 24, i * 150)];
        }

        set state = BridgeState(
            state::Config,
            state::WindowsSession, state::LinuxSession,
            windowsClusters, linuxClusters, new ReplayCluster[0],
            state::SyncRound,
            state::TotalGradientsSynced, state::TotalWeightsSynced,
            state::TotalClustersSynced, state::TotalCheckpoints,
            state::LastSyncTimestamp, state::IsConnected
        );

        // Run federated aggregation rounds
        let nRounds = 5;
        for round in 0 .. nRounds - 1 {
            let step = round * config::GradientSyncFreq;
            let timestamp = round * config::SyncIntervalMs;
            set state = RunFederatedAggregationRound(state, step, timestamp);
        }

        // Final statistics
        LogBridgeStats(state);

        Message("\n[Bridge] Windows ↔ Linux mesh bridge operational.");
        Message("[Bridge] Federated learning pipeline synchronized.");
        Message("[Bridge] Edge ⊗ Firefox ⊗ Windows ⊗ Linux mesh active.");
    }
}
