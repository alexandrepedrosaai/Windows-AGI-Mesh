{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/alexandrepedrosaai/Windows-AGI-Mesh/blob/main/AG-UI/src/schemas/agent.schema.json",
  "title": "AG-UI Agent Definition",
  "type": "object",
  "required": [
    "id",
    "name",
    "role"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "role": {
      "type": "string"
    },
    "enabled": {
      "type": "boolean"
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
