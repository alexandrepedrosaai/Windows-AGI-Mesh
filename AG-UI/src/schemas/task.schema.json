{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/alexandrepedrosaai/Windows-AGI-Mesh/blob/main/AG-UI/src/schemas/task.schema.json",
  "title": "AG-UI Task",
  "type": "object",
  "required": [
    "id",
    "type",
    "input"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "type": {
      "type": "string"
    },
    "input": {},
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "normal",
        "high"
      ]
    },
    "metadata": {
      "type": "object"
    }
  }
}
