{
  "title": "Windows AGI Benchmark Lab \u2014 GPU Performance",
  "uid": "agi-gpu-bench",
  "version": 1,
  "schemaVersion": 38,
  "tags": [
    "agi",
    "gpu",
    "benchmark",
    "microsoft"
  ],
  "panels": [
    {
      "id": 1,
      "title": "GPU Utilization %",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "%",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        }
      },
      "targets": [
        {
          "expr": "avg(amd_gpu_util_pct{project=\"windows-agi-benchmark\"})",
          "legendFormat": "AMD \u2014 GPU Utilization %",
          "refId": "A"
        },
        {
          "expr": "avg(nvidia_gpu_util_pct{project=\"windows-agi-benchmark\"})",
          "legendFormat": "NVIDIA \u2014 GPU Utilization %",
          "refId": "B"
        }
      ],
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
