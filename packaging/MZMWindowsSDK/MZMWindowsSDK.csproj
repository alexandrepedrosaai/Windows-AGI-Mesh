<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <PackageId>MZMWindowsSDK</PackageId>
    <PackageVersion Condition="'$(PackageVersion)' == ''">0.1.0-local</PackageVersion>
    <PackageTitle>MZMWindowsSDK</PackageTitle>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Description>Windows AGI Mesh complete SDK manifest and release contract.</Description>
    <Authors>alexandrepedrosaai</Authors>
    <RepositoryUrl>https://github.com/alexandrepedrosaai/Windows-AGI-Mesh</RepositoryUrl>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="README.md" />
    <None Include="../../mzm-windows-sdk/artifact-manifest.json" Pack="true" PackagePath="build/artifact-manifest.json" />
  </ItemGroup>
</Project>
