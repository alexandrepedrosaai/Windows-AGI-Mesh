    "verify": "npm run typecheck && npm run lint && npm run test:coverage"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^9.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
