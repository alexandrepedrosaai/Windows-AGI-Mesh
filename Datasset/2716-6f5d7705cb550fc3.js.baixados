ationCanvas":{"creatingPresentationSlides":"Creating presentation slides...","downloadAsOfficeFile":"Download as Office File","downloadAsOfficeFiles":"Download as Office Files","downloadAsPPTX":"Download as PPTX","downloadPPTX":"Download PPTX","fullscreenPresentation":"Fullscreen Presentation","present":"Present","presentationFiles":"Presentation Files","slidesWillAppearHere":"Slides will appear here as they are created"},"pwaStatus":{"availableOffline":"Available Offline","installForBetterExperience":"Install this app for a better experience","installedAs":"Installed as","runningAsInstalledApp":"Running as installed app"},"renderingTest":{"flexExample":"Flex Example","flexItem":"Flex Item","gridExample":"Grid Example","shadcnButton":"shadcn Button","submitButton":"Submit Button"},"schedule":{"allFields":"All fields (*)","list":"List (e.g., 1, 15, 30)","range":"Range (e.g., 1-5)","step":"Step (e.g., */5)"},"scheduleEditor":{"generateSchedule":"Generate Schedule","schedule":"Schedule","scheduleEditor":"Schedule Editor","taskDescription":"Task Description","triggerSchedule":"Trigger Schedule"},"slideFrame":{"copyCode":"Copy Code","preview":"Start Presentation"},"streamingToolCall":{"toolCurrentlyRunning":"Tool is currently running","toolExecutionStopped":"Tool execution has been stopped"},"themeSelect":{"excelTheme":"Excel Theme","noThemesAvailable":"No themes available","presentationTheme":"Presentation Theme","selectExcelTheme":"Select Excel Theme","selectPresentationTheme":"Select Presentation Theme","viewLess":"View less","viewMoreThemes":"View more"},"toolCallButton":{"invalidToolCall":"Invalid tool call - content may be malformed or truncated"},"toolCallSidePanel":{"copyToolResponse":"Copy Tool Response","next":"Next","prev":"Prev","running":"Running","stepOfTotal":"Step {{current}} of {{total}}","toolCallDetails":"Tool Call Details","viewOutput":"View Output","viewResult":"View Result"},"toolViews":{"crawlImages":"Crawl Images","phoneCall":"Phone Call","presentationPlanner":"Presentation Planner","searchImages":"Search Images","searchNews":"Searching News","strReplace":"String Replace","webAppPreview":"Web App Preview","webCrawl":"Web Crawl","webSearch":"Web Search","withToolCall":"With Tool Call"},"wordDocumentCanvas":{"generatingDocument":"Generating Document","loadingDocumentPreview":"Loading document preview...","openInWord":"Open in Word"}},"confirmations":{"deleteConversation":{"message":"Are you sure you want to delete the conversation","title":"Delete conversation","warning":"This action cannot be undone. All messages, agent runs, and related data will be permanently removed."}},"connectedAccountsDialog":{"connect":"Connect","connected":"Connected","connecting":"Connecting...","description":"Manage your connected external accounts","disconnect":"Disconnect","disconnectConfirmMessage":"Are you sure you want to disconnect {{provider}}? You will need to re-enter your credentials to reconnect.","disconnectConfirmTitle":"Disconnect Account","disconnecting":"Disconnecting...","noAccounts":"No personal connectors available","notConnected":"Not connected","signInWith":"Sign in with {{provider}}","title":"Connected Accounts"},"dashboard":{"greeting":"Hi {{userName}}, what can I do for you?","predefinedPrompts":{"call":{"label":"Call","prompts":[{"promptSuggestion":"Call the nearby Thai restaurant and book a table for two next Friday at 7 PM, preferably by the window.","title":"Thai Restaurant Table Booking"},{"promptSuggestion":"Call the client and ask how satisfied they are with the product they received.","title":"Client Satisfaction Phone Call"},{"promptSuggestion":"Contact the delivery company and reschedule my package to be delivered tomorrow afternoon.","title":"Package Delivery Rescheduling"},{"promptSuggestion":"Contact the home cleaning service and cancel my scheduled appointment for this month.","title":"Cleaning Service Cancellation"}]},"code":{"label":"Code","prompts":[{"promptSuggestion":"Summarize the sites for tracking mobile app download rankings and create a data pipeline on a simple web page.","title":"App Ranking Data Pipeline"},{"promptSuggestion":"Write a function in JavaScript to parse JSON data and transform it into a usable format.","title":"JavaScript JSON Parser Function"},{"promptSuggestion":"Generate a step-by-step coding tutorial on how to create a backend logic for a login and register system.","title":"Login System Coding Tutorial"},{"promptSuggestion":"Explain what this code does and suggest some improvements for debugging.","title":"Code Explanation and Debugging"}]},"excel":{"label":"Analyze data","prompts":[{"promptSuggestion":"Review the past 20 annual reports of CBA and provide a table of operating income and cash NPAT for each year.","title":"CBA Financial Performance Table"},{"promptSuggestion":"Create an Excel with ChatGPT and Gemini mobile app weekly downloads in the past 12 months.","title":"ChatGPT vs. Gemini: Mobile App Download Stats"},{"promptSuggestion":"Analyze Microsoft (MSFT) and NVIDIA (NVDA) stock price and volume trends during 2020~2025 on monthly basis and return me an Excel file.","title":"MSFT vs. NVIDIA: Stock Trends 2020-2025"},{"promptSuggestion":"Create an Excel of Tesla, BYD, Toyota global EV sales by quarter from 2021 to 2024.","title":"Global EV Sales of Tesla, BYD, Toyota"}]},"powerpoint":{"label":"Create slide","prompts":[{"promptSuggestion":"Create a professional investment analysis presentation based on the latest real-time stock data for Microsoft (MSFT)","title":"Analyze MSFT Stock Performance"},{"promptSuggestion":"Create a clear, educational presentation explaining the basics of Federal Reserve interest rates. Break it down into 3 simple sections: What are they? How do they affect inflation? And how do they impact average consumers?","title":"Explain Fed Rate Impact"},{"promptSuggestion":"Create a generic pitch deck template for a tech startup. Include standard slides: The Problem, The Solution, Our Mission, and The Team. Use placeholder text that is inspiring and easy to replace. Style: High-tech, Dark Mode aesthetic. Use neon accents and bold typography to make it look futuristic.","title":"Create a Startup Pitch Deck"},{"promptSuggestion":"Draft a creative marketing plan for a new lifestyle brand. Outline 5 creative campaign ideas involving Social Media (Instagram/TikTok) and Influencer partnerships. Keep the text punchy and short.","title":"Generate a Marketing Plan"},{"promptSuggestion":"Design a visual storytelling deck about the history of Coffee. Create a timeline from the 15th century to modern Starbucks culture. Include fun facts about Espresso and Latte. Style: Warm, Vintage/Retro style. Use brown and beige tones to mimic the coffee shop atmosphere.","title":"Create a Coffee History Guide"}]},"word":{"label":"Write document","prompts":[{"promptSuggestion":"Act as a Tech Analyst. Research and summarize the top technology news headlines from the last 7 days. Format: Create a structured \'Weekly Briefing\' document. Group news into categories (e.g., AI, Hardware, Policy). For each item, provide a one-sentence summary and a \'Why it matters\' takeaway.","title":"Summarize Recent Tech News"},{"promptSuggestion":"Draft a comprehensive Crisis Response Plan for a hypothetical data breach scenario. Content: Include three key sections: 1. Immediate Internal Response Steps (for IT & Legal), 2. Public Statement/Press Release draft (apologetic but professional), and 3. A FAQ list for concerned customers. Tone: Urgent, professional, and reassuring.","title":"Draft a Crisis Response Strategy"},{"promptSuggestion":"Write a persuasive cover letter for a Senior Product Manager role. Structure: 1. Introduction (hook the reader), 2. Key Achievements (highlight experience in Agile and driving growth), 3. Passion for the industry, 4. Call to Action. Use placeholders like [Company Name] for easy customization. Tone: Confident and enthusiastic.","title":"Write a Cover Letter"},{"promptSuggestion":"Create a proposal for a 1-day team building event for a team of 20 people, with a limited budget ($50 per person). Output: Propose 3 distinct themes (e.g., \'Outdoor Adventure\', \'Creative Workshop\', \'City Scavenger Hunt\'). For each theme, provide a rough agenda and a cost breakdown estimate.","title":"Plan Budget Team Building"},{"promptSuggestion":"Act as a Creative Director. List 10 innovative marketing ideas for a new mobile app launch. Focus: Focus on digital-first, low-cost tactics (e.g., Gamification, User-Generated Content campaigns, or unexpected Cross-brand collaborations). Constraint: Ensure all ideas are positive, safe, and community-driven. Output: For each idea, explain the \'Viral Hook\'—why users would naturally want to share it with their friends.","title":"Brainstorm Viral Marketing Ideas"}]}}},"debug":{"admin":{"accessConsoleHelpers":"Access console helpers via window.streamReplay","adminControls":"Admin Controls","clear":"Clear","clearAll":"Clear All","clearData":"Clear Data","clearMemory":"Clear Memory","clearMemoryConfirm":"Are you sure you want to clear memory? This action cannot be undone.","clearThread":"Clear Thread","clearThreadConfirm":"Are you sure you want to clear the thread?","confirmClearAll":"Are you sure you want to clear all log data? This action cannot be undone.","confirmSave":"Are you sure you want to save this data? It will overwrite any existing data.","conversationTitle":"Conversation Title","created":"Created","data":"Data","debugSettings":"Debug Settings","debugUI":"Debug UI","deleteEntry":"Delete Entry","deleted":"deleted","description":"Description","editEntry":"Edit Entry","editLogData":"Edit Log Data","emailRequired":"Email is required","enableDebugUIToShowPanel":"Enable Debug UI to show the replay control panel (page will auto-reload)","enterThreadId":"Enter thread ID","enterUserEmail":"Enter a user email to search for their conversations","failedToClearMemory":"Failed to clear memory","failedToClearThr