circuit DeepSpace {
  format_version: "1.0"
  kind: "storage-resilience"

  scope {
    purpose: "Study resilient storage and recovery under simulated extreme operating conditions."
    includes: [
      "Fault injection for interruption, corruption, constrained bandwidth, and unavailable peers.",
      "Integrity checks, replication strategies, and recovery behavior for mesh state.",
      "Simulation-first experiments with documented assumptions."
    ]
    excludes: [
      "Claims of survivability in physical extremes without relevant hardware testing.",
      "Replication of sensitive data without explicit owner policy."
    ]
  }

  metrics {
    metric integrity_detection: { unit: "percent", target: "report by fault type" }
    metric recovery_time: { unit: "seconds", target: "report distribution by scenario" }
    metric recovery_point: { unit: "records", target: "report data loss after injected faults" }
    metric storage_overhead: { unit: "percent", target: "report against unreplicated baseline" }
    metric offline_availability: { unit: "percent", target: "report by tested partition duration" }
  }

  integration_pipeline {
    stage 1: "Create synthetic, classified test data and declare the fault model."
    stage 2: "Configure policy-bounded replicas and verify encryption and integrity metadata."
    stage 3: "Inject reproducible faults in an isolated test environment."
    stage 4: "Measure detection, recovery, data loss, and resource overhead."
    stage 5: "Verify restored data against signed checksums and emit an audit summary."
  }

  security {
    rules: [
      "Use synthetic or explicitly authorized data in resilience experiments.",
      "Encrypt replicas and authenticate peers; do not weaken production controls for fault injection.",
      "Enforce retention and deletion across replicas, including disconnected peers on reconnection.",
      "Do not expose recovery keys in logs or test artifacts.",
      "Keep destructive fault tests confined to disposable, isolated environments."
    ]
  }
}
