circuit EdgeAIApp {
  format_version: "1.0"
  kind: "sovereign-edge-intelligence"

  scope {
    purpose: "Run distributed and embedded AI models locally on Windows PCs under owner-controlled policy."
    includes: [
      "Local inference and task routing across explicitly authorized mesh peers.",
      "Offline-capable workflows where model and device resources permit.",
      "Optional cloud-in-PC collaboration through a transparent, revocable policy gateway."
    ]
    excludes: [
      "Silent upload of prompts, files, telemetry, or model outputs.",
      "Guarantees of model capability, privacy, or availability beyond measured and documented behavior."
    ]
  }

  metrics {
    metric local_task_completion: { unit: "percent", target: "report by model, task, and device class" }
    metric inference_latency: { unit: "milliseconds", target: "report median and tail percentiles" }
    metric peak_memory: { unit: "megabytes", target: "report by model and context size" }
    metric offline_completion: { unit: "percent", target: "report supported workflows and failure modes" }
    metric external_data_transfer: { unit: "bytes", target: "report per task and destination" }
    metric energy_use: { unit: "watt-hours", target: "report measurement method and device" }
  }

  integration_pipeline {
    stage 1: "Inventory compatible Windows hardware and verify model and package signatures."
    stage 2: "Select a local model and resource limits according to user policy and device capability."
    stage 3: "Run inference in an isolated process with least-privilege access to user-approved inputs."
    stage 4: "Use peer or cloud routes only when separately authorized, with destination and data class visible."
    stage 5: "Validate outputs, expose provenance and resource use, and apply configured retention."
    stage 6: "Support operator audit, revocation, model removal, and local data deletion."
  }

  security {
    rules: [
      "Default to local processing; require explicit consent for every external data route.",
      "Use signed models, secure update channels, and Windows-supported credential storage.",
      "Isolate model execution from the host and mediate file, device, and network access.",
      "Apply least privilege, encryption, data minimization, and configurable retention.",
      "Treat model outputs and retrieved content as untrusted; require approval for consequential actions.",
      "Provide a clear kill switch and documented behavior when disconnected."
    ]
  }
}
