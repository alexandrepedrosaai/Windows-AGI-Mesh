<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>qmeshc</ToolCommandName>
    <PackageType>DotnetTool</PackageType>
    <PackageId>MZM.Hilbert.DSL</PackageId>
    <PackageTitle>MZM Hilbert DSL QMesh compiler</PackageTitle>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageVersion Condition="'$(PackageVersion)' == ''">0.3.0-local</PackageVersion>
    <Authors>alexandrepedrosaai</Authors>
    <Description>QMesh DSL compiler and Q# QIR graph tool for MZM Hilbert DSL.</Description>
    <RepositoryUrl>https://github.com/alexandrepedrosaai/Windows-AGI-Mesh</RepositoryUrl>
    <PackageTags>QMesh;QSharp;QIR;MajoranaZenithSDK;Hilbert</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="README.md" />
  </ItemGroup>
</Project>
